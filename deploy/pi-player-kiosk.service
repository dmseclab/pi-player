[Unit]
Description=Pi Player RK Chromium Kiosk (X11 fallback)
After=graphical.target pi-player-api.service
Wants=pi-player-api.service

[Service]
Type=simple
User=pi
Group=pi
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/pi/.Xauthority
Environment=PI_PLAYER_URL=http://127.0.0.1:8000/player
ExecStartPre=/bin/sleep 8
ExecStart=/opt/pi-player-rk/deploy/launch-kiosk.sh
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
