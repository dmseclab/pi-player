# OPT-IN LAB ONLY: Not installed/enabled by the normal Pi Player installer.
# RuntimeDirectory must be accessible to the dedicated kiosk agent group.
[Unit]
Description=Pi Player opt-in MPV descriptor broker
After=pi-player-api.service
Requires=pi-player-api.service

[Service]
Type=simple
User=pi-player-broker
Group=pi-player-mpv
UMask=0007
RuntimeDirectory=pi-player-mpv-broker
RuntimeDirectoryMode=0710
WorkingDirectory=/opt/pi-player-rk
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/pi-player-rk/.venv/bin/python -m pi_player.mpv_broker_service --runtime-dir /run/pi-player-mpv-broker --database /var/lib/pi-player/pi_player.sqlite3 --assets /var/lib/pi-player/assets --api-user pi --kiosk-user pi-player-mpv
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/var/lib/pi-player

[Install]
WantedBy=multi-user.target
