[Unit]
Description=Pi Player RK API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/opt/pi-player-rk
Environment=PI_PLAYER_DATA_DIR=/var/lib/pi-player
Environment=PI_PLAYER_LOG_DIR=/var/log/pi-player
EnvironmentFile=-/etc/pi-player/environment
Environment="PI_PLAYER_RESTART_CMD=/usr/bin/systemctl restart pi-player-kiosk.service"
ExecStart=/opt/pi-player-rk/.venv/bin/python -m uvicorn pi_player.application:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
